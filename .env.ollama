# إعدادات تشغيل المشروع عبر Ollama (محليًا على جهازك)
#
# Ollama بيوفر endpoint متوافق مع OpenAI على /v1، فبنفس كود OpenAICompatible
# اللي بيشتغل مع Groq/OpenAI بيشتغل مع Ollama من غير أي كود إضافي — بس البيانات تتغيّر.
#
# طريقة الاستخدام:
#   1) شغّل Ollama:      ollama serve
#   2) نزّل موديل:        ollama pull llama3.1
#   3) انسخ الملف ده لـ .env:   cp .env.ollama .env
#   أو ببساطة استخدم واجهة الـ Streamlit (streamlit_app.py) واختار وضع "Ollama (محلي)"
#   من غير ما تلمس أي ملف .env خالص.

LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1
LLM_TIMEOUT=30
LLM_MAX_ATTEMPTS=3
LLM_BASE_DELAY=1.0
